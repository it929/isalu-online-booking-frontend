# Isalu Hospitals backend: production settings template.
# Copy to backend/.env on the server and fill in real values.
# Never commit the filled-in file.

# --- Django core
SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=False
ALLOWED_HOSTS=your-domain.com,www.your-domain.com
CSRF_TRUSTED_ORIGINS=https://your-domain.com,https://www.your-domain.com
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

# --- Login tokens
JWT_ACCESS_MINUTES=480
JWT_REFRESH_DAYS=7

# --- Rate limits
THROTTLE_ANON=120/min
THROTTLE_USER=600/min
THROTTLE_LOGIN=10/min
THROTTLE_PUBLIC_BOOKING=30/hour
THROTTLE_PUBLIC_LOOKUP=30/min

# --- Redis (live feed and cache): either REDIS_URL, or host/port/password
REDIS_URL=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# --- SMS (EbulkSMS)
EBULKSMS_USERNAME=
EBULKSMS_API_KEY=
EBULKSMS_SENDER_ID=ISALU
EBULKSMS_API_URL=https://api.ebulksms.com/sendsms.json

# --- Email (SMTP)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Isalu Hospitals <no-reply@your-domain.com>
